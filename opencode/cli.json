{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "solarized",
    "mode": "light"
  },
  "keybinds": {
    "agent.cycle": "tab",
    "prompt.editor": "ctrl+e,<leader>e",
    "input.line.end": "none",
    "session.first": "pageup",
    "session.last": "pagedown,end"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": false,
  "tabs": {
    "mode": "off"
  }
}
